# Copy to api/.env and fill in values. Never commit the real file.

# --- App ---
ENV=dev
CORS_ORIGINS=http://localhost:3001

# --- Supabase (dev project, Mumbai region) ---
SUPABASE_URL=
# Secret key (sb_secret_...). Server-only: never put this in web/.
SUPABASE_SECRET_KEY=
# Postgres connection string (Supabase → Project Settings → Database)
DATABASE_URL=

# --- Redis queue (Upstash) ---
REDIS_URL=

# --- AI providers ---
# Which one reads documents: gemini or claude (both are built in).
LLM_PROVIDER=gemini
# Gemini (aistudio.google.com → Get API key). Free tier: Google may use the data,
# so turn on billing before reading real personal documents.
GEMINI_API_KEY=
# Claude (console.anthropic.com → API keys). Set a monthly spend limit there too.
ANTHROPIC_API_KEY=
# Search embeddings: gemini (free, uses GEMINI_API_KEY; no reranker) or voyage
# (embeddings + reranker; add a payment method on Voyage for usable rate limits).
# After switching, re-embed stored chunks: uv run python -m app.scripts.reembed
EMBEDDINGS_PROVIDER=gemini
# Voyage AI key (dashboard.voyageai.com → API keys), only for EMBEDDINGS_PROVIDER=voyage.
EMBEDDINGS_API_KEY=
