# Copy to api/.env and fill in values. Never commit the real file.

# --- App ---
ENV=dev
CORS_ORIGINS=http://localhost:3001

# --- Supabase (dev project, Mumbai region) ---
SUPABASE_URL=
# Secret key (sb_secret_...). Server-only: never put this in web/.
SUPABASE_SECRET_KEY=
# Postgres connection string (Supabase → Project Settings → Database)
DATABASE_URL=

# --- Redis queue (Upstash) ---
REDIS_URL=

# --- AI providers ---
# Claude (console.anthropic.com → API keys). Set a monthly spend limit there too.
ANTHROPIC_API_KEY=
# Voyage AI (dashboard.voyageai.com → API keys): embeddings + reranking.
EMBEDDINGS_API_KEY=
