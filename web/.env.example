# Copy to web/.env.local and fill in. These values are all safe to be public:
# NEXT_PUBLIC_* variables are bundled into the browser code by design.

# Supabase → Project Settings → Data API → Project URL (without /rest/v1/)
NEXT_PUBLIC_SUPABASE_URL=
# Supabase → Project Settings → API Keys → Publishable key (sb_publishable_...)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Where the FastAPI server runs
NEXT_PUBLIC_API_URL=http://localhost:8001

# Dev only: skip login and use fake data. Ignored in production builds.
# DEMO_MODE=1
