{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--dir",
        "web",
        "dev",
        "--port",
        "3001"
      ],
      "port": 3001
    },
    {
      "name": "api",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "--directory",
        "api",
        "uvicorn",
        "app.main:app",
        "--reload",
        "--port",
        "8001"
      ],
      "port": 8001
    }
  ]
}
